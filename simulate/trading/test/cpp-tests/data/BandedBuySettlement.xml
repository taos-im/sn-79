<!--
    The simulation's grids and a price band of 10%, with no fees, so that what a fill moves is its
    notional and nothing else. Its twin, BandedBuySettlementNoBand.xml, differs in exactly one
    attribute: maxPriceBand is absent there. A test pair across the two files isolates the band.
-->
<Simulation start="0" duration="11" mode="test">
    <Agents>
        <MultiBookExchangeAgent name="EXCHANGE" priceDecimals="2" volumeDecimals="4" baseDecimals="4" quoteDecimals="10"
            remoteAgentCount="2" maxLeverage="4" maxLoan="5000" maintenanceMargin="0.1"
            initialPrice="300.0" minOrderSize="0.0001" maxPriceBand="0.10">
            <FeePolicy type="tiered" historySlots="30" slotPeriod="864">
                <Tier volumeRequired="0" makerFee="0.0" takerFee="0.0"/>
            </FeePolicy>
            <Books instanceCount="1" algorithm="PriceTime" maxDepth="21"/>
            <Balances>
                <Base total="1001.0" maxLeverage="5" maxLoan="10000"/>
                <Quote total="50001.0" maxLeverage="5" maxLoan="10000"/>
            </Balances>
        </MultiBookExchangeAgent>
        <DistributedProxyAgent/>
    </Agents>
</Simulation>
