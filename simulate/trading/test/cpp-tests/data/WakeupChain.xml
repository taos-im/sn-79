<!--
  Fixture for WakeupChainTests: two books, four StylizedTrader instances.

  StylizedTrader is the exemplar token-passing class: instance 0 seeds one chain per
  book at simulation start and every wake hands the token to a randomly chosen
  instance, so the whole class's order flow rides on one message per book staying
  alive. Two books so the tests can break one chain and assert the other is untouched.

  Driven through a bare Simulation (not SimulationManager), so no POSIX IPC object is
  created and the test cannot collide with any other taosim on the host. The
  DistributedProxyAgent node is present only because Simulation::configureAgents throws
  without it.

  step is explicit at 1 s because the watchdog sweep runs on the step signal and the
  default step is 1 ns, which would sweep a billion times per simulated second. Agent
  order matters: StylizedTraderAgent::configure() reads books().size() and the
  fundamental process, so the exchange has to be configured first. minDMD/maxDMD are
  tightened relative to production so a healthy chain hops many times inside the run and
  a broken one is detected inside it.
-->
<Simulation start="0" duration="60000000000" step="1000000000" timescale="ns" rngSeed="1337">
    <Agents>
        <MultiBookExchangeAgent name="EXCHANGE" gracePeriod="10000000000" priceDecimals="2" volumeDecimals="4"
            baseDecimals="4" quoteDecimals="10" remoteAgentCount="1"
            maxLeverage="4" maxLoan="10000" maintenanceMargin="0.25"
            initialPrice="300.0" minOrderSize="0.25">
            <Books instanceCount="2" algorithm="PriceTime">
                <!--
                  GBM, not FundamentalPrice, and named "fundamental" because that is the
                  name StylizedTrader looks up. FundamentalPrice cannot be configured
                  under a bare Simulation at all: ProcessFactory hands it
                  &m_shared->fundamentalPriceL, and SharedResources is owned by
                  SimulationManager, so m_shared is null here and the process constructor
                  dereferences it. Any process works for these tests, which assert on the
                  wakeup chain rather than on prices.
                -->
                <Processes>
                    <GBM name="fundamental" X0="300.0" mu="0.0" sigma="0.01" dt="0.0001"
                        seed="1337" updatePeriod="1000000000"/>
                    <MagneticField name="magneticfield" numRows="32" beta="0.5" alpha="20.0"
                        updatePeriod="10000000000"/>
                    <FuturesSignal name="external" lambda="0.001155" seedInterval="10000000000"
                        updatePeriod="10000000000"/>
                </Processes>
            </Books>
            <Balances>
                <Base total="100.0" maxLeverage="5" maxLoan="10000"/>
                <Quote total="5000.0" maxLeverage="5" maxLoan="10000"/>
            </Balances>
        </MultiBookExchangeAgent>
        <StylizedTraderAgent name="STYLIZED_TRADER_AGENT" instanceCount="4"
            exchange="EXCHANGE" debug="0"
            MFLmean="250000000" MFLstd="50000000"
            minOPLatency="90000000" maxOPLatency="300000000" opLatencyScaleRay="0.235"
            delayMean="10000000000" delaySTD="1000000000"
            sigmaN="0.7" sigmaC="2.3" sigmaF="5.0"
            tau="600000000000" tauHist="50" tauF="1"
            volGuard="0.000001" sigmaEps="0.002" r_aversion="100000" HARA="2.0"
            regimeChangeFlag="0"
            acdOmega="5.0" acdAlpha="0.15" acdBeta="0.65"
            minDMD="2000000000" maxDMD="10000000000" pO_alpha="0.0">
            <Balances>
                <Base total="500" maxLeverage="4" maxLoan="10000"/>
                <Quote total="150000.0" maxLeverage="4" maxLoan="10000"/>
            </Balances>
        </StylizedTraderAgent>
        <!--
          NoiseTrader and FuturesTrader are the other two token chains. They hand the token on
          from the same handler that reads L1, so they exercise a different pairing of
          noteWake and arm than StylizedTrader does. Delays are tightened relative to
          production so both hop many times inside a 60 s run.
        -->
        <NoiseTraderAgent name="NOISE_TRADER_AGENT" instanceCount="4" exchange="EXCHANGE"
            debug="0" MFLmean="1500000000" MFLstd="167000000"
            minOPLatency="90000000" maxOPLatency="300000000" meanVolume="2.3"
            tau="1800000000000" balanceCoef="0.90"
            acdOmega="2.5" acdAlpha="0.45" acdBeta="0.45" acdGamma="15.0"
            sigmaExp="0.00000001" weight="1.0" minDMD="2000000000" maxDMD="10000000000">
            <Balances>
                <Base total="500" maxLeverage="4" maxLoan="10000"/>
                <Quote total="150000.0" maxLeverage="4" maxLoan="10000"/>
            </Balances>
        </NoiseTraderAgent>
        <FuturesTraderAgent name="FUTURES_TRADER_AGENT" instanceCount="4" exchange="EXCHANGE"
            debug="0" delayMean="5000000000" delaySTD="500000000"
            MFLmean="250000000" MFLstd="50000000"
            minOPLatency="90000000" maxOPLatency="300000000"
            sigmaN="0.7" volume="8.0" orderTypeProb="0.5" sigmaEps="0.5" tau="600000000000">
            <Balances>
                <Base total="500" maxLeverage="1" maxLoan="10000"/>
                <Quote total="150000.0" maxLeverage="1" maxLoan="10000"/>
            </Balances>
        </FuturesTraderAgent>
        <!--
          Two HFT instances so the same fixture covers the other wakeup shape: a self timer,
          keyed per agent per book rather than per class. Attributes are the production
          template's, as in HFTOwnFill.xml.
        -->
        <HighFrequencyTraderAgent name="HIGH_FREQUENCY_TRADER_AGENT" instanceCount="2"
            exchange="EXCHANGE" debug="0"
            minMFLatency="100000000" minOPLatency="1000000" maxOPLatency="50000000"
            opLatencyScaleRay="0.235" tau="2" delta="750000000"
            gHFT="0.5" sigmaSqr="0.01" kappa="1.6" spread="0.0015" psiHFT_quotes="5.0"
            orderMean="2.5" orderSTD="1.0" quoteSizeVolumeFrac="1.0"
            noiseRay="0.23" shiftPercentage="0.05"
            sensitivityCoef="100.0" spreadSensitivityExp="1.5"
            spreadSensitivityBase="0.00015" rateMax="0.0075" marginNoiseSTD="0.00001">
            <Balances>
                <Base total="500" maxLeverage="4" maxLoan="10000"/>
                <Quote total="150000.0" maxLeverage="4" maxLoan="10000"/>
            </Balances>
        </HighFrequencyTraderAgent>
        <!--
          One ALGOTrader, which reads the book at depth and then the top of book, both now
          taken directly off the exchange. volumeStatsPeriod is far below production so its
          periodic read fires many times inside a 60 s run; nothing here is a calibration
          statement.
        -->
        <ALGOTraderAgent name="ALGO_TRADER_AGENT" instanceCount="1" exchange="EXCHANGE"
            MFLmean="100000000" MFLstd="25000000"
            volumeStatsPeriod="2000000000"
            updateInterval="60000000000" updateSTD="10000000000"
            minOPLatency="90000000" maxOPLatency="5000000000"
            depth="21" volumeDrawRayleighScale="2000.0"
            alpha="0.2" beta="0.7" gammaX="0.2" omega="0.00000001"
            activationMidpoint="0.025" activationRate="100.0"
            immediateBase="600.0" parentOrderAdvFraction="0.05" wakeDeviationCoef="0.5"
            wakeupTimeCoef="259200000000000">
            <VolumeDistribution type="lognormal" mu="1.8" sigma="0.9"/>
            <Balances>
                <Base total="167000.0" maxLeverage="1" maxLoan="10000"/>
                <Quote total="50000000.0" maxLeverage="1" maxLoan="10000"/>
            </Balances>
        </ALGOTraderAgent>
        <!--
          One RandomTrader, the remaining self-timer class, so the per-agent shape of the
          watchdog stays covered now that the maker has moved onto a token.
        -->
        <RandomTraderAgent name="RANDOM_TRADER_AGENT" instanceCount="1" exchange="EXCHANGE"
            tau="1000000000" graceDelay="2000000000" stepDelay="1000000000"
            minQuantity="0.5" maxQuantity="2.0">
            <Balances>
                <Base total="500" maxLeverage="1" maxLoan="10000"/>
                <Quote total="150000.0" maxLeverage="1" maxLoan="10000"/>
            </Balances>
        </RandomTraderAgent>
        <DistributedProxyAgent/>
    </Agents>
</Simulation>
